{
  "$schema": "https://opencode.ai/config.json",
  "model": "finnscode/gpt-6.1-sol#medium",
  "permission": "allow",
  "plugin": [
    "oh-my-opencode-slim@3.0.4"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "provider": {
    "commandcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "commandcode",
      "options": {
        "baseURL": "{env:COMMANDCODE_BASE_URL}",
        "apiKey": "{env:COMMANDCODE_API_KEY}"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "family": "deepseek-flash",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "reasoning_options": [
            { "type": "toggle" },
            { "type": "effort", "values": ["low", "medium", "high", "max"] }
          ],
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "deepseek/deepseek-v4-flash": {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek-flash",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "reasoning_options": [
            { "type": "toggle" },
            { "type": "effort", "values": ["low", "medium", "high", "max"] }
          ],
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "z-ai/glm-5.3-flash": {
          "id": "z-ai/glm-5.3-flash",
          "name": "GLM-5.3 Flash",
          "family": "glm",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 200000,
            "output": 40000
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    },
    "copilot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Copilot (local)",
      "options": {
        "baseURL": "http://127.0.0.1:4141/v1",
        "apiKey": "{env:COPILOT_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "id": "claude-opus-5",
          "name": "Claude Opus 5 (Copilot)",
          "family": "claude",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning_options": [
            { "type": "effort", "values": ["low", "medium", "high", "xhigh", "max"] }
          ],
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 264000,
